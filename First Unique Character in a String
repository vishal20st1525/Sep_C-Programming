#include <string.h>

int firstUniqChar(char* s) {
    // Array to store the frequency counts of all 26 lowercase English letters
    int count[26] = {0};
    
    // 1. First pass: Count the frequency of each character in the string
    for (int i = 0; s[i] != '\0'; i++) {
        count[s[i] - 'a']++;
    }
    
    // 2. Second pass: Find the first character with a frequency count of 1
    for (int i = 0; s[i] != '\0'; i++) {
        if (count[s[i] - 'a'] == 1) {
            return i; // Return the 0-indexed position
        }
    }
    
    // If no unique character is found, return -1
    return -1;
}
