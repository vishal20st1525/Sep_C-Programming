struct ListNode* addTwoNumbers(struct ListNode* l1, struct ListNode* l2) {
    // Create a dummy head node to simplify list construction
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = NULL;
    struct ListNode* current = &dummy;
    
    int carry = 0;
    
    // Loop until both lists are exhausted and there is no carry left
    while (l1 != NULL || l2 != NULL || carry != 0) {
        int sum = carry;
        
        if (l1 != NULL) {
            sum += l1->val;
            l1 = l1->next;
        }
        
        if (l2 != NULL) {
            sum += l2->val;
            l2 = l2->next;
        }
        
        // Calculate new carry and the digit to store
        carry = sum / 10;
        
        // Allocate memory for the new node
        struct ListNode* newNode = (struct ListNode*)malloc(sizeof(struct ListNode));
        newNode->val = sum % 10;
        newNode->next = NULL;
        
        // Link the new node and move the current pointer forward
        current->next = newNode;
        current = current->next;
    }
    
    return dummy.next;
}
