#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    int* data;
    int front;
    int rear;
    int capacity;
    int size;
} MyCircularQueue;

// Unique internal helpers to avoid template redefinition clashes
static bool isQueueEmptyInternal(MyCircularQueue* obj) {
    return obj->size == 0;
}

static bool isQueueFullInternal(MyCircularQueue* obj) {
    return obj->size == obj->capacity;
}

MyCircularQueue* myCircularQueueCreate(int k) {
    MyCircularQueue* obj = (MyCircularQueue*)malloc(sizeof(MyCircularQueue));
    obj->data = (int*)malloc(sizeof(int) * k);
    obj->front = 0;
    obj->rear = -1;
    obj->capacity = k;
    obj->size = 0;
    return obj;
}

bool myCircularQueueEnQueue(MyCircularQueue* obj, int value) {
    if (isQueueFullInternal(obj)) {
        return false;
    }
    obj->rear = (obj->rear + 1) % obj->capacity;
    obj->data[obj->rear] = value;
    obj->size++;
    return true;
}

bool myCircularQueueDeQueue(MyCircularQueue* obj) {
    if (isQueueEmptyInternal(obj)) {
        return false;
    }
    obj->front = (obj->front + 1) % obj->capacity;
    obj->size--;
    return true;
}

int myCircularQueueFront(MyCircularQueue* obj) {
    if (isQueueEmptyInternal(obj)) {
        return -1;
    }
    return obj->data[obj->front];
}

int myCircularQueueRear(MyCircularQueue* obj) {
    if (isQueueEmptyInternal(obj)) {
        return -1;
    }
    return obj->data[obj->rear];
}

bool myCircularQueueIsEmpty(MyCircularQueue* obj) {
    return isQueueEmptyInternal(obj);
}

bool myCircularQueueIsFull(MyCircularQueue* obj) {
    return isQueueFullInternal(obj);
}

void myCircularQueueFree(MyCircularQueue* obj) {
    free(obj->data);
    free(obj);
}
