#include <stdio.h>
#include <stdlib.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int longestSubarray(int* nums, int numsSize, int limit) {
    // Deques to store indices of max and min elements
    int* maxDeque = (int*)malloc(numsSize * sizeof(int));
    int* minDeque = (int*)malloc(numsSize * sizeof(int));
    
    int maxHead = 0, maxTail = 0;
    int minHead = 0, minTail = 0;
    
    int left = 0;
    int maxLen = 0;
    
    for (int right = 0; right < numsSize; right++) {
        // 1. Maintain maxDeque in decreasing order
        while (maxHead < maxTail && nums[maxDeque[maxTail - 1]] <= nums[right]) {
            maxTail--;
        }
        maxDeque[maxTail++] = right;
        
        // 2. Maintain minDeque in increasing order
        while (minHead < minTail && nums[minDeque[minTail - 1]] >= nums[right]) {
            minTail--;
        }
        minDeque[minTail++] = right;
        
        // 3. Shrink the window if the condition is violated
        while (nums[maxDeque[maxHead]] - nums[minDeque[minHead]] > limit) {
            left++;
            // Remove out-of-bounds indices from the front of deques
            if (maxDeque[maxHead] < left) {
                maxHead++;
            }
            if (minDeque[minHead] < left) {
                minHead++;
            }
        }
        
        // 4. Update the maximum length found so far
        maxLen = MAX(maxLen, right - left + 1);
    }
    
    free(maxDeque);
    free(minDeque);
    
    return maxLen;
}
