#include <stdlib.h>
#include <stdbool.h>

#define MAX_SIZE 1000

// A basic array-based stack wrapper structure
typedef struct {
    int data[MAX_SIZE];
    int top;
} Stack;

Stack* createStack() {
    Stack* s = (Stack*)malloc(sizeof(Stack));
    s->top = -1;
    return s;
}

void stackPush(Stack* s, int val) {
    s->data[++(s->top)] = val;
}

int stackPop(Stack* s) {
    return s->data[(s->top)--];
}

int stackPeek(Stack* s) {
    return s->data[s->top];
}

bool isStackEmpty(Stack* s) {
    return s->top == -1;
}

// -------------------------------------------------------------
// The requested MyQueue structure leveraging our stack structures
// -------------------------------------------------------------
typedef struct {
    Stack* inStack;
    Stack* outStack;
} MyQueue;

MyQueue* myQueueCreate() {
    MyQueue* obj = (MyQueue*)malloc(sizeof(MyQueue));
    obj->inStack = createStack();
    obj->outStack = createStack();
    return obj;
}

void myQueuePush(MyQueue* obj, int x) {
    // Push new elements straight onto the primary input stack
    stackPush(obj->inStack, x);
}

// Internal helper to shift elements from input stack to output stack
void shiftStacks(MyQueue* obj) {
    // Only transfer elements if outStack is completely empty
    if (isStackEmpty(obj->outStack)) {
        while (!isStackEmpty(obj->inStack)) {
            stackPush(obj->outStack, stackPop(obj->inStack));
        }
    }
}

int myQueuePop(MyQueue* obj) {
    shiftStacks(obj);
    return stackPop(obj->outStack);
}

int myQueuePeek(MyQueue* obj) {
    shiftStacks(obj);
    return stackPeek(obj->outStack);
}

bool myQueueEmpty(MyQueue* obj) {
    return isStackEmpty(obj->inStack) && isStackEmpty(obj->outStack);
}

void myQueueFree(MyQueue* obj) {
    free(obj->inStack);
    free(obj->outStack);
    free(obj);
}

