#include <stdio.h>
#include <stdlib.h>

// Simple Node structure for a Doubly-Linked List to act as our Deque
typedef struct Node {
    int val;
    struct Node* prev;
    struct Node* next;
} Node;

typedef struct {
    Node* head;
    Node* tail;
    int size;
} Deque;

typedef struct {
    Deque* left;
    Deque* right;
} FrontMiddleBackQueue;

// Helper to create a new Deque node
Node* createNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val = val;
    node->prev = NULL;
    node->next = NULL;
    return node;
}

// Helper to initialize a Deque
Deque* createDeque() {
    Deque* dq = (Deque*)malloc(sizeof(Deque));
    dq->head = NULL;
    dq->tail = NULL;
    dq->size = 0;
    return dq;
}

void pushFrontDQ(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = dq->tail = node;
    } else {
        node->next = dq->head;
        dq->head->prev = node;
        dq->head = node;
    }
    dq->size++;
}

void pushBackDQ(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = dq->tail = node;
    } else {
        dq->tail->next = node;
        node->prev = dq->tail;
        dq->tail = node;
    }
    dq->size++;
}

int popFrontDQ(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* temp = dq->head;
    int val = temp->val;
    dq->head = dq->head->next;
    if (dq->head) dq->head->prev = NULL;
    else dq->tail = NULL;
    free(temp);
    dq->size--;
    return val;
}

int popBackDQ(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* temp = dq->tail;
    int val = temp->val;
    dq->tail = dq->tail->prev;
    if (dq->tail) dq->tail->next = NULL;
    else dq->head = NULL;
    free(temp);
    dq->size--;
    return val;
}

// Balance the two halves to ensure size properties match constraints
void balance(FrontMiddleBackQueue* obj) {
    if (obj->left->size > obj->right->size) {
        pushFrontDQ(obj->right, popBackDQ(obj->left));
    } else if (obj->right->size > obj->left->size + 1) {
        pushBackDQ(obj->left, popFrontDQ(obj->right));
    }
}

// Main Queue API implementations
FrontMiddleBackQueue* frontMiddleBackQueueCreate() {
    FrontMiddleBackQueue* obj = (FrontMiddleBackQueue*)malloc(sizeof(FrontMiddleBackQueue));
    obj->left = createDeque();
    obj->right = createDeque();
    return obj;
}

void frontMiddleBackQueuePushFront(FrontMiddleBackQueue* obj, int val) {
    pushFrontDQ(obj->left, val);
    balance(obj);
}

void frontMiddleBackQueuePushMiddle(FrontMiddleBackQueue* obj, int val) {
    if (obj->left->size == obj->right->size) {
        pushFrontDQ(obj->right, val); // Will sit right at the start of the right half
    } else {
        pushBackDQ(obj->left, val);
    }
    balance(obj);
}

void frontMiddleBackQueuePushBack(FrontMiddleBackQueue* obj, int val) {
    pushBackDQ(obj->right, val);
    balance(obj);
}

int frontMiddleBackQueuePopFront(FrontMiddleBackQueue* obj) {
    if (obj->left->size == 0 && obj->right->size == 0) return -1;
    int val = (obj->left->size > 0) ? popFrontDQ(obj->left) : popFrontDQ(obj->right);
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopMiddle(FrontMiddleBackQueue* obj) {
    if (obj->left->size == 0 && obj->right->size == 0) return -1;
    int val;
    if (obj->left->size == obj->right->size) {
        val = popBackDQ(obj->left);
    } else {
        val = popFrontDQ(obj->right);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopBack(FrontMiddleBackQueue* obj) {
    if (obj->left->size == 0 && obj->right->size == 0) return -1;
    int val = popBackDQ(obj->right);
    balance(obj);
    return val;
}

void frontMiddleBackQueueFree(FrontMiddleBackQueue* obj) {
    while (obj->left->size > 0) popFrontDQ(obj->left);
    while (obj->right->size > 0) popFrontDQ(obj->right);
    free(obj->left);
    free(obj->right);
    free(obj);
}
