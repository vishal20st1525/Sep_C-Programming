#include <string.h>
#include <stdlib.h>

// Helper function to expand outward from a given center
int expandAroundCenter(char* s, int left, int right, int len) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return the length of the found palindrome
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    int len = strlen(s);
    if (len < 1) return "";

    int start = 0;
    int max_len = 0;

    for (int i = 0; i < len; i++) {
        // Case 1: Odd length (center is i)
        int len1 = expandAroundCenter(s, i, i, len);
        // Case 2: Even length (center is between i and i+1)
        int len2 = expandAroundCenter(s, i, i + 1, len);
        
        // Find the maximum of the two lengths
        int current_max = (len1 > len2) ? len1 : len2;
        
        // Update the global maximum and starting boundary
        if (current_max > max_len) {
            max_len = current_max;
            start = i - (current_max - 1) / 2;
        }
    }

    // Allocate memory for the result substring (+1 for null terminator)
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    strncpy(result, s + start, max_len);
    result[max_len] = '\0'; // Null-terminate the C-string

    return result;
}
