#include <stdlib.h>

/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     struct TreeNode *left;
 *     struct TreeNode *right;
 * };
 */

// Helper function to count total nodes in the tree
int countNodes(struct TreeNode* root) {
    if (root == NULL) return 0;
    return 1 + countNodes(root->left) + countNodes(root->right);
}

// Helper function to handle the preorder recursive traversal
void traversePreorder(struct TreeNode* root, int* result, int* returnSize) {
    if (root == NULL) return;
    
    // 1. Visit current root node first
    result[(*returnSize)++] = root->val;
    
    // 2. Traverse left subtree
    traversePreorder(root->left, result, returnSize);
    
    // 3. Traverse right subtree
    traversePreorder(root->right, result, returnSize);
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* preorderTraversal(struct TreeNode* root, int* returnSize) {
    *returnSize = 0;
    
    // Determine tree size for memory allocation
    int totalNodes = countNodes(root);
    if (totalNodes == 0) {
        return NULL;
    }
    
    int* result = (int*)malloc(sizeof(int) * totalNodes);
    
    // Fill the array using the preorder logic
    traversePreorder(root, result, returnSize);
    
    return result;
}
